{
  "name": "master-code",
  "version": "0.2.0",
  "description": "Agente de codigo estilo Claude Code / opencode usando NVIDIA NIM",
  "type": "module",
  "bin": {
    "master-code": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/context.test.ts tests/context2.test.ts tests/context3.test.ts tests/update.semver.test.ts tests/update.core.test.ts tests/update.integration.test.ts tests/update.notes.test.ts",
    "build:exe": "powershell -ExecutionPolicy Bypass -File scripts/build-exe.ps1",
    "build:setup": "powershell -ExecutionPolicy Bypass -File scripts/build-installer.ps1",
    "install:exe": "powershell -ExecutionPolicy Bypass -File scripts/install.ps1",
    "uninstall:exe": "powershell -ExecutionPolicy Bypass -File scripts/uninstall.ps1"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "openai": "^4.67.3"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
